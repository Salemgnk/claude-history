#compdef claude-history
# Complétion zsh pour claude-history.
_claude-history() {
  if (( CURRENT == 2 )); then
    local -a cmds
    cmds=(${(f)"$(claude-history _complete commands 2>/dev/null)"})
    _describe 'commande' cmds
    return
  fi
  case "${words[2]}" in
    show|export)
      if (( CURRENT == 3 )); then
        local -a projs
        projs=(${(f)"$(claude-history _complete projects 2>/dev/null)"})
        _describe 'projet' projs
      elif (( CURRENT == 4 )); then
        local -a ids
        ids=(${(f)"$(claude-history _complete ids ${words[3]} 2>/dev/null)"})
        _describe 'conversation' ids
      fi
      ;;
  esac
}
_claude-history "$@"
